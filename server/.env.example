# Copie para server/.env (nunca commitar). Sem DATABASE_URL, usa as variáveis PG*.
DATABASE_URL=postgres://usuario@localhost:5432/cantum
APP_ORIGIN=http://localhost:5173
PORT=8787
# Produção (ADR-060; valores reais só no painel do Render):
# BREVO_API_KEY=        # liga o envio de e-mail pelo Brevo; sem ele, links vão para o log (só dev)
# MAIL_FROM=CANTUM <remetente-verificado@exemplo.com>
# TRUST_PROXY=true      # atrás de proxy: rate limit pelo IP do cliente
# HOST=0.0.0.0
