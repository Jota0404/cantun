# Copie para .env.local (ignorado pelo Git) e preencha.
# Servidor próprio (ADR-059). Em dev o padrão é http://localhost:8787.
# Use `localhost` (não 127.0.0.1): o cookie de sessão exige front e API no mesmo site.
VITE_API_URL=

# Opcional: HTTPS no `npm run preview` (testes em dispositivo na rede local).
# Estas duas são lidas pelo vite.config.ts via process.env: exporte no shell, ex.:
#   PREVIEW_HTTPS_KEY=./dev-key.pem PREVIEW_HTTPS_CERT=./dev.pem npm run preview
# Caminhos para certificado/chave gerados localmente (ex.: mkcert). Arquivos *.pem são ignorados pelo Git.
PREVIEW_HTTPS_KEY=
PREVIEW_HTTPS_CERT=
